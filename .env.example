# ============================================================
# ObraFlux - Environment Variables Example
# Copy this file to .env and fill in the values
# ============================================================

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
OBRAFLUX_DOMAIN=obraflux.com

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/obraflux_dev?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── JWT Authentication ──────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ──────────────────────────────────────────────
# 32-byte hex string for AES-256 encryption (64 hex chars)
ENCRYPTION_KEY=your-64-char-hex-encryption-key-for-sensitive-fields-like-rtsp

# ─── Two-Factor Authentication ───────────────────────────────
TOTP_APP_NAME=ObraFlux

# ─── AWS / S3 ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=obraflux-uploads-dev

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — BASIC plan
STRIPE_PRICE_BASIC_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BASIC_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — PROFESSIONAL plan
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — ENTERPRISE plan
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email / SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@obraflux.com

# ─── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# ─── Frontend (exposed to browser via NEXT_PUBLIC_) ──────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OAuth — Google ──────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── OAuth — Microsoft / Azure AD ────────────────────────────
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Live Monitoring (go2rtc) ────────────────────────────────
GO2RTC_URL=http://localhost:1984
